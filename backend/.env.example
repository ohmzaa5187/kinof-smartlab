PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=kinof_app
DB_PASSWORD=replace_with_a_real_password
DB_DATABASE=kinof
JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_PUBLIC_URL=http://localhost:5173
ISSUE_UPLOAD_DIR=storage/issues
FACE_SERVICE_URL=http://127.0.0.1:8001
FACE_SERVICE_API_KEY=replace_with_a_long_random_secret
FACE_MATCH_THRESHOLD=0.55
FACE_MATCH_MARGIN=0.04
ENTRY_OTP_SECRET=replace_with_a_different_long_random_secret
# Production must provide a delivery webhook. It receives email/code/expiresInMinutes.
ENTRY_OTP_WEBHOOK_URL=
ENTRY_OTP_WEBHOOK_KEY=
# Production webhook receives email/resetUrl/expiresInMinutes.
PASSWORD_RESET_WEBHOOK_URL=
PASSWORD_RESET_WEBHOOK_KEY=

# Brevo SMTP for login/entry OTP and password-reset links.
# SMTP_USER = SMTP login from Brevo (SMTP & API).
# SMTP_PASSWORD = generated SMTP key, not the Brevo account password.
# SMTP_FROM = a sender address verified in Brevo.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
